@model carrental.Models.car_type

@{
    ViewBag.Title = "cardetails";
}
@{
    Layout = "~/Views/Shared/_Userlayout2.cshtml";
}

<div class="container-fluid pt-5">
    <div class="container pt-5 pb-3">
        <h1 class="display-4 text-uppercase mb-5"> @Html.DisplayFor(model => model.car_name)</h1>
        <div class="row align-items-center pb-2">
            <div class="col-lg-6 mb-4">
                <img class="img-fluid" src="~/Upload/@Model.images" style="width:100%; height:50%" alt="">
            </div>
            <div class="col-lg-6 mb-4">
                <h4 class="mb-2">₹ @Html.DisplayFor(model => model.Per_day_price)/ Full Day / Self Driven</h4>

                <div class="d-flex mb-3">
                    <h6 class="mr-2">Rating:</h6>
                    <div class="d-flex align-items-center justify-content-center mb-1">
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star text-primary mr-1"></small>
                        <small class="fa fa-star-half-alt text-primary mr-1"></small>
                        <small>(250)</small>
                    </div>
                </div>
                <p>@Html.DisplayFor(model => model.Descriptiton)</p>
                <div class="d-flex pt-1">
                    <h6>Share on:</h6>
                    <div class="d-inline-flex">
                        <a class="px-2" href=""><i class="fab fa-facebook-f"></i></a>
                        <a class="px-2" href=""><i class="fab fa-twitter"></i></a>
                        <a class="px-2" href=""><i class="fab fa-linkedin-in"></i></a>
                        <a class="px-2" href=""><i class="fab fa-pinterest"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-n3 mt-lg-0 pb-4">
            <div class="col-md-3 col-6 mb-2">
                <i class="fa fa-car text-primary mr-2"></i>
                <span>Model:    @Html.DisplayFor(model => model.Brand.brand_name) </span>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <i class="fa Example of calendar fa-calendar text-primary mr-2"></i>
                <span>Year: @Html.DisplayFor(model => model.Manufacture)</span>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <i class="fa fa-users text-primary mr-2"></i>
                <span>Seats: @Html.DisplayFor(model => model.No_of_seats)</span>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <i class="fa fa-dice-d20 text-primary mr-2"></i>
                <span>Type: @Html.DisplayFor(model => model.car_category.category_name)</span>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <i class="fa fa-map-marker text-primary mr-2"></i>
                <span>City: @Html.DisplayFor(model => model.City.city_name)</span>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <i class="fa fa-gas-pump text-primary mr-2"></i>
                <span>Fuel: @Html.DisplayFor(model => model.Fuel_Type.Fuel_Type1)</span>
            </div>
            <div class="col-md-3 col-6 mb-2">
                <i class="fa  fa-digital-tachograph text-primary mr-2"></i>
                <span>Car Number: @Html.DisplayFor(model => model.Car_number)</span>
            </div>

            <div class="col-md-3 col-6 mb-2">
                <i class="fa  fa-map-marker text-primary mr-2"></i>
                <span>GPS Navigation</span>
            </div>

        </div>
    </div>
</div>
<!-- Detail End -->
