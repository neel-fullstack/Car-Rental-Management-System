@using (Html.BeginForm("cardetails", "user", FormMethod.Post))
{
    @Html.HiddenFor(model => model.car_Id)

    <center>
        <div class="col-lg-9 mb-5">
            <div class="bg-secondary p-4">
                <h3 class="text-primary text-center mb-4">Check Availability</h3>
                <div class="row mx-n2">
                    <div class="col-xl-3 col-lg-4 col-md-6 px-2">
                        <select class="custom-select px-4 mb-3 " style="height: 50px;" name="pickup">


                            <option>Pickup Location</option>

                            <option>

                                @Html.DisplayFor(model => model.City.city_name)

                            </option>

                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 px-2">
                        <select class="custom-select px-4 mb-3" style="height: 50px;" name="Drop">
                            <option selected>Drop Location</option>
                            @foreach (var data in ViewData["City"] as IEnumerable<carrental.Models.City>)
                            {
                                <option>

                                    @data.city_name

                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 px-2">
                        <div class="date mb-3" id="date1" data-target-input="nearest">
                            <input type="text" class="form-control p-4 datetimepicker-input" placeholder="Pickup Date"
                                   data-target="#date1" data-toggle="datetimepicker" name="Date" />
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 px-2">
                        <div class="time mb-3" id="time1" data-target-input="nearest">
                            <input type="text" class="form-control p-4 datetimepicker-input" placeholder="Pickup Time"
                                   data-target="#time1" data-toggle="datetimepicker" name="Time" />
                        </div>
                    </div>


                    <div class="col-xl-12 col-lg-4 col-md-6 px-2">
                        <button class="btn btn-primary btn-block" type="submit" style="height: 50px;">Book Now</button>
                    </div>
                </div>
           
    </center>





<br />

<div class="container-fluid pb-5">
    <div class="container pb-5">
        <h2 class="display-4 text-uppercase mb-5">Related Cars</h2>
        <div class="owl-carousel related-carousel position-relative" style="padding: 0 30px;">
            <div class="rent-item">
                <img class="img-fluid mb-4" src="img/car-rent-1.png" alt="">
                <h4 class="text-uppercase mb-4">

                    @Html.DisplayFor(modelItem =>Model.car_name)

                </h4>
                <div class="d-flex justify-content-center mb-4">
                    <div class="px-2">
                        <i class="fa fa-car text-primary mr-1"></i>
                        <span>2015</span>
                    </div>
                    <div class="px-2 border-left border-right">
                        <i class="fa fa-cogs text-primary mr-1"></i>
                        <span>AUTO</span>
                    </div>
                    <div class="px-2">
                        <i class="fa fa-road text-primary mr-1"></i>
                        <span>25K</span>
                    </div>
                </div>
                <a class="btn btn-primary px-3" href="">$99.00/Day</a>
            </div>
            
        </div>
    </div>
</div>


}