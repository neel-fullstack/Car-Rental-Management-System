@model carrental.Models.booking
@{
    Layout = "~/Views/Shared/_Userlayout2.cshtml";
    carrental.Models.car_type cc = (carrental.Models.car_type)ViewData["cartype"];
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<button class="btn btn-info" id="download"><i class="fa fa-file-pdf-o"></i> Export as PDF</button>
<br />
<br />
<div class="invoice overflow-auto" id="invoice">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="d-flex flex-row p-4  bg-secondary ">
                            <div class="col-md-6">
                                <img src="~/Admin/assets/images/whitelogo.png" height="70px" width="250px">
                            </div>

                            <div class="col-md-6 text-right">
                                <p class="font-weight-bold mb-1 text-primary">Invoice #@Model.booking_Id</p>
                                <p class="text-white">Booking Date:@Model.booking_date</p>
                            </div>
                        </div>



                        <div class="row pb-5 p-5">
                            <div class="col-md-6">
                                <p class="font-weight-bold mb-4">Customer Information</p>
                                <p class="mb-1">@Model.User.user_name @Model.User.user_lastname</p>
                                <p class="mb-1">@Model.User.user_contact</p>
                                <p class="mb-1">@Model.User.user_emailid</p>
                            </div>

                            <div class="col-md-6 text-right">
                                <p class="font-weight-bold mb-4">Payment Details</p>
                                @*<p class="mb-1"><span class="text-muted">VAT: </span> 1425782</p>
                                    <p class="mb-1"><span class="text-muted">VAT ID: </span> 10253642</p>*@
                                <p class="mb-1"><span class="text-muted">Payment Type: </span> @Model.mode_of_payment</p>

                            </div>
                        </div>

                        <div class="row p-5">
                            <div class="col-md-12">
                                <table class="table">
                                    <thead>
                                        <tr>

                                            <th class="border-0 text-uppercase small font-weight-bold">Car</th>
                                            <th class="border-0 text-uppercase small font-weight-bold">Pickup Location</th>
                                            <th class="border-0 text-uppercase small font-weight-bold">Drop Location</th>
                                            <th class="border-0 text-uppercase small font-weight-bold">Start Date</th>
                                            <th class="border-0 text-uppercase small font-weight-bold">End Date</th>
                                            <th class="border-0 text-uppercase small font-weight-bold">No Of Days</th>
                                            <th class="border-0 text-uppercase small font-weight-bold">Driver</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>@Model.car_type.car_name</td>

                                            <td>@Model.pickuplocation</td>
                                            <td>@Model.droplocation</td>
                                            <td>@Model.start_date</td>
                                            <td>@Model.end_date</td>
                                            <td>@Model.no_of_days</td>
                                            <td>@Model.with_without_driver</td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex flex-row-reverse bg-secondary text-white p-4">
                            <div class="py-3 px-5 text-right">
                                <div class="mb-2 text-primary">Grand Total</div>
                                <div class="h2 font-weight-light text-white">₹@Model.net_amount_pay</div>
                            </div>

                            <div class="py-3 px-5 text-right">
                                <div class="mb-2 text-primary">Driver Charge</div>
                                <div class="h2 font-weight-light text-white">₹@Model.driver_charge</div>
                            </div>

                            <div class="py-3 px-5 text-right">
                                <div class="mb-2 text-primary">Bill amount</div>
                                <div class="h2 font-weight-light text-white">₹@Model.bill_amount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-primary mt-5 mb-5 text-center ">Thank You For Booking <a class="text-secondary" href="/user/index">BACK TO HOME</a></div>

    </div>



