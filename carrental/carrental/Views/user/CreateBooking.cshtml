<script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script>
    /*$("#start_date").change(function () {
        alert("The text has been changed.");
    });*/
    $("#end_date").change(function () {
        var sdate = $("#start_date").val();
        var edate = $("#end_date").val();
        
         var   date1 = new Date(sdate);
      var  date2 = new Date(edate);
        var milli_secs = date1.getTime() - date2.getTime();

        // Convert the milli seconds to Days 
        var days = milli_secs / (1000 * 3600 * 24);
        var ndays = Math.round(Math.abs(days));
        $("#No_Of_Days").val(ndays);

        var perdayprice = $("#perdayprice").val();
        var total = ndays * perdayprice;
        $("#Bill_Amount").val(total);
        var dcharge = 1000;
        var totaldriver = 0;
        var res = $("input[name='driver']:checked").val();
        //alert(res);
        if (res == "With Driver")
            totaldriver = ndays * dcharge;
        //alert(totaldriver);

        $("#Driver_charge").val(totaldriver);
        $("#Net_Amount_Pay").val(totaldriver + total);
        //alert("The text has been changed." + total + "  " + perdayprice + ndays);
    });
</script>