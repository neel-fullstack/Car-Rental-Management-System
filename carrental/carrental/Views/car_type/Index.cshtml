<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12">

            <div class="row my-4">
                <!-- Small table -->
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-body">
                            <!-- table -->
                            <h2>CAR TYPE DETAILS</h2>
                            <a href="~/car_type/Create" class="btn btn-primary">Add New </a> <br></br>
                            <table class="table datatables" id="dataTable-1">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>images</th>
                                        <th>car_name <br> model</th>
                                        <th>seats</th>

                                        <th>price</th>
                                        <th>brand <br> fuel</th>
                                        <th>category</th>

                                        <th>city <br> Car_number</th>
                                        <th>Description</th>
                                        <th>Edit</th>
                                        <th>Delete</th>


                                    </tr>
                                </thead>
                                <tbody>


                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <img src="~/upload/@item.images" height="80px" width="100px" />
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.car_name)
                                                <br>
                                                @Html.DisplayFor(modelItem => item.Manufacture)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.No_of_seats)
                                            </td>

                                           
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Per_day_price)₹
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.Brand.brand_name)
                                                <br />
                                                @Html.DisplayFor(modelItem => item.Fuel_Type.Fuel_Type1)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.car_category.category_name)
                                            </td>
                                           
                                            <td>

                                                @Html.DisplayFor(modelItem => item.City.city_name)
                                                <br />
                                                @Html.DisplayFor(modelItem => item.Car_number)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Descriptiton)
                                            </td>
                                            <td>

                                                <a href="/car_type/Edit/@item.car_Id"><i class="fe fe-edit" style="color:blue"></i></a>
                                            </td>
                                            <td>

                                                <a href="/car_type/Delete/@item.car_Id"><i class="fe fe-trash" style="color:blue"></i></a>
                                            </td>
                                        </tr>
                                    }



                                </tbody>
                            </table>
                        </div>
                    </div>
                </div> <!-- simple table -->
            </div> <!-- end section -->
        </div> <!-- .col-12 -->
    </div> <!-- .row -->
</div> <!-- .container-fluid -->
<div class="modal fade modal-notif modal-slide" tabindex="-1" role="dialog" aria-labelledby="defaultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="defaultModalLabel">Notifications</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="list-group list-group-flush my-n3">
                    <div class="list-group-item bg-transparent">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="fe fe-box fe-24"></span>
                            </div>
                            <div class="col">
                                <small><strong>Package has uploaded successfull</strong></small>
                                <div class="my-0 text-muted small">Package is zipped and uploaded</div>
                                <small class="badge badge-pill badge-light text-muted">1m ago</small>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item bg-transparent">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="fe fe-download fe-24"></span>
                            </div>
                            <div class="col">
                                <small><strong>Widgets are updated successfull</strong></small>
                                <div class="my-0 text-muted small">Just create new layout Index, form, table</div>
                                <small class="badge badge-pill badge-light text-muted">2m ago</small>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item bg-transparent">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="fe fe-inbox fe-24"></span>
                            </div>
                            <div class="col">
                                <small><strong>Notifications have been sent</strong></small>
                                <div class="my-0 text-muted small">Fusce dapibus, tellus ac cursus commodo</div>
                                <small class="badge badge-pill badge-light text-muted">30m ago</small>
                            </div>
                        </div> <!-- / .row -->
                    </div>
                    <div class="list-group-item bg-transparent">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="fe fe-link fe-24"></span>
                            </div>
                            <div class="col">
                                <small><strong>Link was attached to menu</strong></small>
                                <div class="my-0 text-muted small">New layout has been attached to the menu</div>
                                <small class="badge badge-pill badge-light text-muted">1h ago</small>
                            </div>
                        </div>
                    </div> <!-- / .row -->
                </div> <!-- / .list-group -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-block" data-dismiss="modal">Clear All</button>
            </div>
        </div>
    </div>
</div>
